# ─────────────────────────────────────────────────────────
# Velocast — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic (Claude AI) ─────────────────────────────────
# Get free credits at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Groq (Free Whisper Transcription) ────────────────────
# Free tier: https://console.groq.com
GROQ_API_KEY=gsk_...

# ── Stripe (Payments) ────────────────────────────────────
# Test keys from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_CREATOR_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BRAND_PRICE_ID=price_...

# ── Resend (Email) ────────────────────────────────────────
# Free: 3,000 emails/mo — https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@velocast.app

# ── Social Platform APIs ──────────────────────────────────
# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/callback/youtube

# Instagram / Meta Graph API
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/callback/instagram

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/callback/tiktok

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# Twitter/X API v2
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/callback/twitter

# ── Redis (Job Queue — Optional for local dev) ────────────
# Use Upstash free tier: https://upstash.com
REDIS_URL=redis://localhost:6379

# ── Cron Secret (protect cron endpoints) ─────────────────
CRON_SECRET=generate-a-random-string-here
